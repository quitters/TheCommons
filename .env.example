## auto: Gemini when configured, otherwise OpenAI; no key uses the full fallback pool.
## Use fallback to prevent all model calls even when keys are configured.
GENERATION_PROVIDER=auto
GEMINI_API_KEY=
## Optional absolute path to an existing JSON file containing { "api_key": "..." }.
## The file is read on the server; never place it in client/ or commit its contents.
GEMINI_CONFIG_PATH=
GEMINI_MODEL=gemini-3.1-pro-preview
## Long jobs survive browser reloads. Ten-minute request deadline; no automatic retry.
GEMINI_TIMEOUT_MS=600000
## Optional directory for saved prompts and completed sketches (default .commons-data/generations).
GENERATION_DATA_DIR=
OPENAI_API_KEY=
MODEL=gpt-5.6-sol
## Set false for manual remixes only. Enabling it also permits autonomous model calls.
FACILITATOR_ENABLED=true
## Required to sign in at /admin/. Participant stations cannot remix or view generation jobs.
ADMIN_PASSWORD=

PORT=4173
